generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== MODELLI =====

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  CHEF
  USER
}

// ===== INVENTORY MODELS =====

model Ingredient {
  id          Int                 @id @default(autoincrement())
  name        String
  quantity    Float
  unit        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  movements   Movement[]
  products    ProductIngredient[]
  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

model Movement {
  id            Int        @id @default(autoincrement())
  ingredientId  Int
  type          MovementType // IN = entrata, OUT = uscita
  quantity      Float
  createdAt     DateTime   @default(now())
  note          String?     // campo opzionale
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])

  @@map("movements")
}

enum MovementType {
  IN
  OUT
}

// ===== PRODUCTS MODELS =====

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // relazione con ingredienti
  ingredients ProductIngredient[]

  // relazione con ricetta
  recipeId Int?
  recipe   Recipe? @relation(fields: [recipeId], references: [id])

  // relazione con ordini
  orderItems  OrderItem[]

  // relazione con categoria
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model ProductIngredient {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Float      // quantità di ingrediente usata per preparare 1 prodotto

  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId]) // ogni ingrediente può comparire solo una volta per prodotto
  @@map("product_ingredients")
}

// ===== ORDERS =====

model Order {
  id        Int         @id @default(autoincrement())
  tableId   Int?
  customer  String?
  status    OrderStatus @default(PENDING)
  total     Float       @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items     OrderItem[]
  table     Table?      @relation(fields: [tableId], references: [id])

  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Float

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ===== TABLES =====

model Table {
  id        Int         @id @default(autoincrement())
  number    Int         // Numero tavolo (unico)
  seats     Int         // Numero posti
  status    TableStatus @default(FREE)
  note      String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders    Order[]

  @@unique([number])
  @@map("tables")
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLOSED
}

// ===== SUPPLIERS =====

model Supplier {
  id         Int      @id @default(autoincrement())
  name       String
  vatNumber  String   // Partita IVA
  address    String?
  contact    String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([vatNumber])
  @@map("suppliers")
}

model PurchaseOrder {
  id         Int                  @id @default(autoincrement())
  supplierId Int
  orderDate  DateTime             @default(now())
  status     PurchaseOrderStatus  @default(PENDING)
  total      Float                @default(0)
  note       String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  supplier   Supplier             @relation(fields: [supplierId], references: [id])

  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// ===== RECIPES =====

model Recipe {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients RecipeIngredient[]
  products    Product[]

  @@unique([name])
  @@map("recipes")
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Float
  unit         String

  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// ===== RECIPES =====

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?      // es. emoji o nome icona
  color       String?      // es. #3B82F6
  sortOrder   Int     @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("categories")
}