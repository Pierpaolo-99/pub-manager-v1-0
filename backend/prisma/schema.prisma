generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== MODELLI =====

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  movements Movement[]

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  WAITER
  CHEF
  USER
}

// ===== INVENTORY MODELS =====

model Ingredient {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  category        IngredientCategory @default(other)
  unit            String   @db.VarChar(20) @default("g")
  density         Decimal? @db.Decimal(8,3) @default(1.000)
  costPerUnit     Decimal? @db.Decimal(10,4) @default(0.0000)
  supplier        String?  @db.VarChar(200)
  supplierCode    String?  @db.VarChar(100)
  barcode         String?  @db.VarChar(50)
  shelfLifeDays   Int?     @default(30)
  storageType     StorageType @default(ambient)
  allergenInfo    Json?
  nutritionalInfo Json?
  active          Boolean  @default(true)
  quantity        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements       Movement[]
  products        ProductIngredient[]
  recipeIngredients RecipeIngredient[]

  @@map("ingredients")
}

model Movement {
  id              Int      @id @default(autoincrement())
  ingredientId    Int
  batchId         Int?
  type            MovementType
  quantity        Decimal  @db.Decimal(12,3)
  unit            String   @db.VarChar(20)
  costPerUnit     Decimal? @db.Decimal(10,4)
  totalCost       Decimal? @db.Decimal(10,2)
  reason          String?  @db.VarChar(200)
  referenceType   MovementReferenceType @default(manual)
  referenceId     Int?
  locationFrom    String?  @db.VarChar(100)
  locationTo      String?  @db.VarChar(100)
  expiryDate      DateTime?
  batchCode       String?  @db.VarChar(100)
  supplier        String?  @db.VarChar(200)
  invoiceNumber   String?  @db.VarChar(100)
  notes           String?  @db.Text
  userId          Int?
  createdAt       DateTime @default(now())
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  user            User?      @relation(fields: [userId], references: [id])

  @@map("movements")
}

enum MovementType {
  purchase
  sale
  waste
  adjustment
  transfer
  production
}
enum IngredientCategory {
  beverage
  meat
  fish
  vegetable
  dairy
  grain
  spice
  sauce
  other
}

enum StorageType {
  ambient
  refrigerated
  frozen
}

enum MovementReferenceType {
  order
  purchase
  production
  manual
  waste
}

// ===== PRODUCTS MODELS =====

model Product {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(200)
  description      String?   @db.Text
  basePrice        Decimal   @db.Decimal(10,2) @default(0.00)
  imageUrl         String?   @db.VarChar(500)
  active           Boolean   @default(true)
  featured         Boolean   @default(false)
  sortOrder        Int?      @default(0)
  preparationTime  Int?      @default(0)
  calories         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ...relazioni esistenti...
  ingredients      ProductIngredient[]
  orderItems       OrderItem[]
  recipeId         Int?
  recipe           Recipe?   @relation(fields: [recipeId], references: [id])
  categoryId       Int
  category         Category  @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model ProductIngredient {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Float      // quantità di ingrediente usata per preparare 1 prodotto

  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId]) // ogni ingrediente può comparire solo una volta per prodotto
  @@map("product_ingredients")
}

// ===== ORDERS =====

model Order {
  id                 Int           @id @default(autoincrement())
  tableId            Int?
  customer           String?
  status             OrderStatus   @default(PENDING)
  total              Float         @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  items              OrderItem[]
  table              Table?        @relation(fields: [tableId], references: [id])

  // Campi aggiuntivi
  userId             Int?
  customerName       String?       @db.VarChar(200)
  customerPhone      String?       @db.VarChar(20)
  customerEmail      String?       @db.VarChar(100)
  subtotal           Decimal       @db.Decimal(10,2) @default(0.00)
  taxAmount          Decimal       @db.Decimal(10,2) @default(0.00)
  discountAmount     Decimal       @db.Decimal(10,2) @default(0.00)
  discountType       String?       @db.VarChar(20)
  promotionId        Int?
  paymentMethod      PaymentMethod @default(CASH)
  changeGiven        Decimal?      @db.Decimal(10,2)
  paymentStatus      PaymentStatus @default(PENDING)
  notes              String?       @db.Text
  kitchenNotes       String?       @db.Text
  estimatedReadyTime DateTime?     @db.Timestamp(0)
  servedAt           DateTime?     @db.Timestamp(0)
  paidAt             DateTime?     @db.Timestamp(0)
  heldAt             DateTime?     @db.Timestamp(0)
  user               User?         @relation(fields: [userId], references: [id])
  promotion          Promotion?    @relation(fields: [promotionId], references: [id])

  @@map("orders")
}


model OrderItem {
  id            Int              @id @default(autoincrement())
  orderId       Int
  productId     Int
  quantity      Int              @default(1)
  priceAtSale   Decimal          @db.Decimal(10,2)
  subtotal      Decimal          @db.Decimal(10,2)
  notes         String?          @db.Text
  status        OrderItemStatus  @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  order         Order            @relation(fields: [orderId], references: [id])
  product       Product          @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  IN_PREPARAZIONE
  PRONTO
  SERVITO
  PAGATO
  ANNULLATO
}

enum PaymentMethod {
  CASH
  CARD
  BANCOMAT
  APP
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// ===== PROMOTIONS =====

model Promotion {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  description  String?  @db.Text
  type         PromotionType
  value        Decimal  @db.Decimal(10,2)
  minAmount    Decimal? @db.Decimal(10,2) @default(0.00)
  maxDiscount  Decimal? @db.Decimal(10,2)
  startDate    DateTime
  endDate      DateTime
  startTime    DateTime?  @db.Time(0)
  endTime      DateTime?  @db.Time(0)
  daysOfWeek   Json?
  maxUses      Int?
  currentUses  Int?     @default(0)
  active       Boolean  @default(true)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("promotions")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
}

// ===== TABLES =====

model Table {
  id        Int         @id @default(autoincrement())
  number    Int         // Numero tavolo (unico)
  seats     Int         // Numero posti
  location  String?      @db.VarChar(100)
  status    TableStatus @default(FREE)
  note      String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders    Order[]

  @@unique([number])
  @@map("tables")
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLOSED
  CLEANING
}

// ===== SUPPLIERS =====

model Supplier {
  id         Int      @id @default(autoincrement())
  name       String
  vatNumber  String   // Partita IVA
  address    String?
  contact    String?
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([vatNumber])
  @@map("suppliers")
}

model PurchaseOrder {
  id         Int                  @id @default(autoincrement())
  supplierId Int
  orderDate  DateTime             @default(now())
  status     PurchaseOrderStatus  @default(PENDING)
  total      Float                @default(0)
  note       String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  supplier   Supplier             @relation(fields: [supplierId], references: [id])

  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// ===== RECIPES =====

model Recipe {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ingredients RecipeIngredient[]
  products    Product[]

  @@unique([name])
  @@map("recipes")
}

model RecipeIngredient {
  id           Int        @id @default(autoincrement())
  recipeId     Int
  ingredientId Int
  quantity     Float
  unit         String

  recipe       Recipe     @relation(fields: [recipeId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// ===== RECIPES =====

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?      // es. emoji o nome icona
  color       String?      // es. #3B82F6
  sortOrder   Int     @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("categories")
}