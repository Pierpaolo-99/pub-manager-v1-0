generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===== MODELLI =====

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  phone     String?
  role      Role     @default(WAITER)
  active    Boolean  @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]
  movements Movement[]
  sessions  UserSession[]

  @@map("users")
}

enum Role {
  ADMIN
  WAITER
  KITCHEN
  CASHIER
  MANAGER
  CHEF
  USER
}

// ===== USER SESSIONS =====

model UserSession {
  id         String   @id @default(uuid())
  userId     Int
  expiresAt  DateTime
  data       Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

// ===== INVENTORY MODELS =====

model Ingredient {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  category        IngredientCategory @default(other)
  unit            String   @db.VarChar(20) @default("g")
  density         Decimal? @db.Decimal(8,3) @default(1.000)
  costPerUnit     Decimal? @db.Decimal(10,4) @default(0.0000)
  supplier        String?  @db.VarChar(200)
  supplierCode    String?  @db.VarChar(100)
  barcode         String?  @db.VarChar(50)
  shelfLifeDays   Int?     @default(30)
  storageType     StorageType @default(ambient)
  allergenInfo    Json?
  nutritionalInfo Json?
  active          Boolean  @default(true)
  quantity        Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  movements       Movement[]
  products        ProductIngredient[]
  recipeIngredients RecipeIngredient[]
  purchaseOrderItems PurchaseOrderItem[]

  @@map("ingredients")
}

model Movement {
  id              Int      @id @default(autoincrement())
  ingredientId    Int
  batchId         Int?
  type            MovementType
  quantity        Decimal  @db.Decimal(12,3)
  unit            String   @db.VarChar(20)
  costPerUnit     Decimal? @db.Decimal(10,4)
  totalCost       Decimal? @db.Decimal(10,2)
  reason          String?  @db.VarChar(200)
  referenceType   MovementReferenceType @default(manual)
  referenceId     Int?
  locationFrom    String?  @db.VarChar(100)
  locationTo      String?  @db.VarChar(100)
  expiryDate      DateTime?
  batchCode       String?  @db.VarChar(100)
  supplier        String?  @db.VarChar(200)
  invoiceNumber   String?  @db.VarChar(100)
  notes           String?  @db.Text
  userId          Int?
  createdAt       DateTime @default(now())
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  user            User?      @relation(fields: [userId], references: [id])

  @@map("movements")
}

enum MovementType {
  purchase
  sale
  waste
  adjustment
  transfer
  production
}
enum IngredientCategory {
  beverage
  meat
  fish
  vegetable
  dairy
  grain
  spice
  sauce
  other
}

enum StorageType {
  ambient
  refrigerated
  frozen
}

enum MovementReferenceType {
  order
  purchase
  production
  manual
  waste
}

// ===== PRODUCTS MODELS =====

model Product {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(200)
  description      String?   @db.Text
  basePrice        Decimal   @db.Decimal(10,2) @default(0.00)
  imageUrl         String?   @db.VarChar(500)
  active           Boolean   @default(true)
  featured         Boolean   @default(false)
  sortOrder        Int?      @default(0)
  preparationTime  Int?      @default(0)
  calories         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // ...relazioni esistenti...
  ingredients      ProductIngredient[]
  orderItems       OrderItem[]
  recipeId         Int?
  recipe           Recipe?   @relation("RecipeProducts", fields: [recipeId], references: [id])
  categoryId       Int
  category         Category  @relation(fields: [categoryId], references: [id])

  @@map("products")
}

model ProductIngredient {
  id           Int        @id @default(autoincrement())
  productId    Int
  ingredientId Int
  quantity     Float      // quantità di ingrediente usata per preparare 1 prodotto

  product      Product    @relation(fields: [productId], references: [id])
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([productId, ingredientId]) // ogni ingrediente può comparire solo una volta per prodotto
  @@map("product_ingredients")
}

// ===== ORDERS =====

model Order {
  id                 Int           @id @default(autoincrement())
  tableId            Int?
  customer           String?
  status             OrderStatus   @default(PENDING)
  total              Float         @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  userId             Int?
  customerName       String?       @db.VarChar(200)
  customerPhone      String?       @db.VarChar(20)
  customerEmail      String?       @db.VarChar(100)
  subtotal           Decimal       @db.Decimal(10,2) @default(0.00)
  taxAmount          Decimal       @db.Decimal(10,2) @default(0.00)
  discountAmount     Decimal       @db.Decimal(10,2) @default(0.00)
  discountType       String?       @db.VarChar(20)
  promotionId        Int?
  paymentMethod      PaymentMethod @default(CASH)
  changeGiven        Decimal?      @db.Decimal(10,2)
  paymentStatus      PaymentStatus @default(PENDING)
  notes              String?       @db.Text
  kitchenNotes       String?       @db.Text
  estimatedReadyTime DateTime?     @db.Timestamp(0)
  servedAt           DateTime?     @db.Timestamp(0)
  paidAt             DateTime?     @db.Timestamp(0)
  heldAt             DateTime?     @db.Timestamp(0)
  user               User?         @relation(fields: [userId], references: [id])
  promotion          Promotion?    @relation(fields: [promotionId], references: [id])

  items              OrderItem[]
  table              Table?        @relation(fields: [tableId], references: [id])

  @@map("orders")
}


model OrderItem {
  id            Int              @id @default(autoincrement())
  orderId       Int
  productId     Int
  quantity      Int              @default(1)
  priceAtSale   Decimal          @db.Decimal(10,2)
  subtotal      Decimal          @db.Decimal(10,2)
  notes         String?          @db.Text
  status        OrderItemStatus  @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  order         Order            @relation(fields: [orderId], references: [id])
  product       Product          @relation(fields: [productId], references: [id])

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  IN_PREPARAZIONE
  PRONTO
  SERVITO
  PAGATO
  ANNULLATO
}

enum PaymentMethod {
  CASH
  CARD
  BANCOMAT
  APP
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}

// ===== PROMOTIONS =====

model Promotion {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(200)
  description  String?  @db.Text
  type         PromotionType
  value        Decimal  @db.Decimal(10,2)
  minAmount    Decimal? @db.Decimal(10,2) @default(0.00)
  maxDiscount  Decimal? @db.Decimal(10,2)
  startDate    DateTime
  endDate      DateTime
  startTime    DateTime?  @db.Time(0)
  endTime      DateTime?  @db.Time(0)
  daysOfWeek   Json?
  maxUses      Int?
  currentUses  Int?     @default(0)
  active       Boolean  @default(true)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("promotions")
}

enum OrderItemStatus {
  PENDING
  PREPARING
  READY
  SERVED
}

enum PromotionType {
  PERCENTAGE
  FIXED_AMOUNT
  BUY_X_GET_Y
}

// ===== TABLES =====

model Table {
  id        Int         @id @default(autoincrement())
  number    Int         // Numero tavolo (unico)
  seats     Int         // Numero posti
  location  String?      @db.VarChar(100)
  status    TableStatus @default(FREE)
  note      String?
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orders    Order[]

  @@unique([number])
  @@map("tables")
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  CLOSED
  CLEANING
}

// ===== SUPPLIERS =====

model Supplier {
  id                   Int      @id @default(autoincrement())
  name                 String   @db.VarChar(200)
  companyName          String?  @db.VarChar(200)
  vatNumber            String?  @db.VarChar(20)
  taxCode              String?  @db.VarChar(20)
  contactPerson        String?  @db.VarChar(100)
  email                String?  @db.VarChar(100)
  phone                String?  @db.VarChar(20)
  mobile               String?  @db.VarChar(20)
  website              String?  @db.VarChar(200)
  address              String?  @db.Text
  city                 String?  @db.VarChar(100)
  postalCode           String?  @db.VarChar(10)
  country              String?  @db.VarChar(50) @default("Italia")
  paymentTerms         String?  @db.VarChar(100)
  discountPercentage   Decimal? @db.Decimal(5,2) @default(0.00)
  deliveryDays         String?  @db.VarChar(50)
  minOrderAmount       Decimal? @db.Decimal(10,2) @default(0.00)
  notes                String?  @db.Text
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  purchaseOrders       PurchaseOrder[]

  @@unique([vatNumber])
  @@map("suppliers")
}

model PurchaseOrder {
  id                   Int                  @id @default(autoincrement())
  supplierId           Int
  orderNumber          String?              @db.VarChar(50) @unique
  orderDate            DateTime             @default(now())
  expectedDeliveryDate DateTime?
  actualDeliveryDate   DateTime?
  subtotal             Decimal?             @db.Decimal(10,2) @default(0.00)
  taxAmount            Decimal?             @db.Decimal(10,2) @default(0.00)
  discountAmount       Decimal?             @db.Decimal(10,2) @default(0.00)
  shippingCost         Decimal?             @db.Decimal(10,2) @default(0.00)
  total                Decimal?             @db.Decimal(10,2) @default(0.00)
  paymentMethod        String?              @db.VarChar(50)
  paymentTerms         String?              @db.VarChar(100)
  invoiceNumber        String?              @db.VarChar(100)
  deliveryAddress      String?              @db.Text
  notes                String?              @db.Text
  createdBy            Int?
  status               PurchaseOrderStatus  @default(PENDING)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  supplier             Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrderItems   PurchaseOrderItem[]

  @@map("purchase_orders")
}
// ===== PURCHASE ORDER ITEMS =====

model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  purchaseOrderId   Int
  ingredientId      Int
  quantity          Decimal       @db.Decimal(12,3)
  unit              String        @db.VarChar(20)
  unitPrice         Decimal       @db.Decimal(10,4)
  totalPrice        Decimal       @db.Decimal(10,2)
  receivedQuantity  Decimal?      @db.Decimal(12,3) @default(0.000)
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  ingredient        Ingredient    @relation(fields: [ingredientId], references: [id])

  @@map("purchase_order_items")
}

enum PurchaseOrderStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// ===== RECIPES =====

model Recipe {
  id              Int      @id @default(autoincrement())
  name            String   @db.VarChar(200)
  description     String?  @db.Text
  portionSize     Decimal? @db.Decimal(8,2) @default(1.00)
  preparationTime Int?     @default(0)
  cookingTime     Int?     @default(0)
  difficulty      Difficulty @default(medium)
  instructions    String?  @db.Text
  chefNotes       String?  @db.Text
  totalCost       Decimal? @db.Decimal(10,4) @default(0.0000)
  active          Boolean  @default(true)
  version         Int?     @default(1)
  createdBy       Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  ingredients     RecipeIngredient[]
  products        Product[] @relation("RecipeProducts") // Relazione con Product

  @@unique([name])
  @@map("recipes")
}

enum Difficulty {
  easy
  medium
  hard
}

model RecipeIngredient {
  id               Int      @id @default(autoincrement())
  recipeId         Int
  ingredientId     Int
  quantity         Decimal  @db.Decimal(12,3)
  unit             String   @db.VarChar(20)
  notes            String?  @db.Text
  isOptional       Boolean? @default(false)
  preparationStep  Int?     @default(1)
  costPerUnit      Decimal? @db.Decimal(10,4) @default(0.0000)
  totalCost        Decimal? @db.Decimal(10,4) @default(0.0000)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  recipe           Recipe   @relation(fields: [recipeId], references: [id])
  ingredient       Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([recipeId, ingredientId])
  @@map("recipe_ingredients")
}

// ===== CATEGORIES =====

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  icon        String?      // es. emoji o nome icona
  color       String?      // es. #3B82F6
  sortOrder   Int     @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products    Product[]

  @@map("categories")
}